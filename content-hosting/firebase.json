{
  "hosting": {
    "site": "lighfight-assets-72b24",
    "public": "../.tools/publish",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/*content_state*"
    ],
    "headers": [
      {
        "source": "/lighfight/*/*/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/lighfight/*/latest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=60"
          }
        ]
      }
    ]
  }
}
