sampler2D _MainTex,_BumpMap,_MetallicGlossMap;float4 _PaintColor;float _MaskDiagnostic;struct Input{float2 uv_MainTex;float3 worldPos;float3 localPos;};void vert(inout appdata_full v,out Input o){UNITY_INITIALIZE_OUTPUT(Input,o);o.localPos=v.vertex.xyz;}void surf(Input i,inout SurfaceOutputStandard o){float3 c=tex2D(_MainTex,i.uv_MainTex).rgb;float3 encoded=LinearToGammaSpace(c);float lo=min(encoded.r,min(encoded.g,encoded.b));float hi=max(encoded.r,max(encoded.g,encoded.b));float l=dot(encoded,float3(.2126,.7152,.0722));float mask=smoothstep(.012,.055,encoded.b-encoded.r)*smoothstep(.025,.09,hi-lo)*smoothstep(.025,.08,l);mask*=1-smoothstep(1.16,1.23,i.localPos.y)*(1-smoothstep(1.72,1.82,i.localPos.y));float wheel0=length(float2(i.localPos.z-1.4,i.localPos.y-.5));float wheel1=length(float2(i.localPos.z+1.4,i.localPos.y-.5));float wheel=smoothstep(.43,.56,min(wheel0,wheel1));mask*=lerp(1,wheel,smoothstep(.55,.75,abs(i.localPos.x)));o.Albedo=lerp(c,_PaintColor.rgb*clamp(l/.25,.4,1.3),mask);float4 rm=tex2D(_MetallicGlossMap,i.uv_MainTex);o.Metallic=rm.r;o.Smoothness=rm.a;o.Normal=UnpackNormal(tex2D(_BumpMap,i.uv_MainTex));o.Alpha=1;if(_MaskDiagnostic>.5){o.Albedo=0;o.Metallic=0;o.Smoothness=0;o.Emission=mask.xxx;}}ENDCG}Fallback Off}